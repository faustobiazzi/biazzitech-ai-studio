# Chaves de API do BiazziTech AI Studio (ficam em %USERPROFILE%\.env)
# O instalador e a aba Provedores do painel gravam este arquivo para você.
# Basta UMA chave por provedor; o rodízio usa os que estiverem preenchidos.

# --- Gratuitos (com limites) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys (o rodízio usa só modelos ":free")
OPENROUTER_API_KEY=
# Pollinations (funciona sem chave, com limites): https://auth.pollinations.ai
POLLINATIONS_API_KEY=

# --- Pagos (créditos / assinatura) ---
# Ollama Cloud: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# ChatGPT (OpenAI): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Claude (Anthropic): https://platform.claude.com/settings/keys
# (nome CLAUDE_API_KEY de propósito, para não interferir em ferramentas que leem ANTHROPIC_API_KEY)
CLAUDE_API_KEY=
# xAI Grok: https://console.x.ai
XAI_API_KEY=

# --- Imagens / pixel art (pagos) ---
# PixelLab: https://pixellab.ai/account
PIXELLAB_API_KEY=
# Retro Diffusion: https://www.retrodiffusion.ai/app/devtools
RETRODIFFUSION_API_KEY=
# Scenario: CHAVE:SEGREDO (app.scenario.com > Organization settings > API Keys)
SCENARIO_API_KEY=
# PixAI (usado pelo MCP): https://pixai.art
PIXAI_API_KEY=
# Hugging Face (imagens grátis com FLUX.1-schnell): https://huggingface.co/settings/tokens
HF_TOKEN=
# Together AI (imagens Flux): https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# Fal.ai (imagens Flux): https://fal.ai/dashboard/keys
FAL_KEY=
# Stability AI (SD3 / Core): https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# --- IA local (o instalar_ollama.ps1 preenche) ---
# OLLAMA_ENABLED=1
# OLLAMA_MODEL=qwen2.5-coder:7b

# --- Várias chaves do mesmo provedor (opcional) ---
# Sufixo _2 ... _9 (ex.: GROQ_API_KEY_2=...). Cada uma vira "Groq #2" e fica no FIM do rodízio
# (só é usada se todos os outros provedores falharem, ou se você pedir um modelo daquele serviço).
# ATENÇÃO: criar várias contas no mesmo serviço para somar limites grátis costuma violar os termos de
# uso e pode levar ao bloqueio de todas as contas. A responsabilidade é de quem usa.
# Pausa (segundos) entre uma chave e outra do mesmo provedor:
# ROUTER_KEY_DELAY=5

# --- Ajustes do rodízio (opcional) ---
# ROUTER_ORDER=gemini,groq,openrouter,ollama_cloud,deepseek,openai,anthropic,xai,ollama,pollinations
# GROQ_MODEL=openai/gpt-oss-120b        (fixa o modelo de um provedor)
# GEMINI_DAILY_LIMIT=250                (para de usar um provedor após N pedidos no dia)
